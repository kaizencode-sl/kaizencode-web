---
import "@/styles/global.css"
import { ClientRouter } from "astro:transitions"
import { ui, languages, defaultLang, type Lang } from "@/i18n/ui"
import { getAlternatePath } from "@/i18n/utils"
import { team } from "@/lib/team"
import { Header } from "@/components/custom/header"
import { GravityStarsBackground } from "@/components/animate-ui/components/backgrounds/gravity-stars"

export interface Props {
  lang?: Lang
  title?: string
  description?: string
}

const {
  lang = defaultLang,
  title,
  description = "Software & e-commerce studio building custom solutions, beautiful websites, and scalable e-commerce platforms.",
} = Astro.props

const siteName = "Kaizencode"
// How people may type the brand: one unknown word gets split into "kaizen
// code", so tell Google these all name the same company
const brandVariants = ["Kaizen Code", "KaizenCode", "kaizencode.es"]
const defaultTitle = `${siteName} — Software & e-commerce solutions`
const resolvedTitle = title ?? defaultTitle

// Canonical — always the current page's URL without query parameters
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href

// Normalise BASE_URL to always have a trailing slash
const rawBase = import.meta.env.BASE_URL as string
const basePath = rawBase.endsWith("/") ? rawBase : `${rawBase}/`

// Absolute OG image URL — must be fully absolute for OG scrapers
const siteOrigin = Astro.site?.origin ?? ""
const ogImageUrl = `${siteOrigin}${basePath}og/og-image.png`

// hreflang alternate URLs — Spanish at root, English at /en/
const alternates = (Object.keys(languages) as Lang[]).flatMap((code) => {
  const path = getAlternatePath(Astro.url.pathname, code)
  return path ? [{ code, href: `${siteOrigin}${path}` }] : []
})
const defaultUrl = alternates.find(({ code }) => code === defaultLang)?.href

// og:locale format: en → en_US, es → es_ES
const ogLocaleMap: Record<Lang, string> = { en: "en_US", es: "es_ES" }
const ogLocale = ogLocaleMap[lang]
const ogLocaleAlt = lang === "en" ? ogLocaleMap["es"] : ogLocaleMap["en"]

// Google reads the site name from the WebSite data on the home page
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "/en/"
---

<!doctype html>
<html
  lang={lang}
  class="dark motion-safe:scroll-smooth"
  data-home={isHome ? "" : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow" />

    <title>{resolvedTitle}</title>
    <meta name="description" content={description} />
    <!-- Follows the site theme, not the OS one: synced by the theme script -->
    <meta name="theme-color" content="#0a0a0a" />

    <!-- Canonical & hreflang -->
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map(({ code, href }) => (
      <link rel="alternate" hreflang={code} href={href} />
    ))}
    {defaultUrl && (
      <link rel="alternate" hreflang="x-default" href={defaultUrl} />
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    {alternates.length > 1 && (
      <meta property="og:locale:alternate" content={ogLocaleAlt} />
    )}

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicons -->
    <link
      rel="icon"
      type="image/png"
      href={`${basePath}favicon/favicon-96x96.png`}
      sizes="96x96"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${basePath}favicon/favicon.svg`}
    />
    <link rel="shortcut icon" href={`${basePath}favicon/favicon.ico`} />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={`${basePath}favicon/apple-touch-icon.png`}
    />
    <meta name="apple-mobile-web-app-title" content={siteName} />
    <link rel="manifest" href={`${basePath}favicon/site.webmanifest`} />

    <ClientRouter />
    <script is:inline>
      ;(function () {
        const html = document.documentElement
        const setTheme = () => {
          let theme = "dark"
          try {
            // Throws when site data is blocked
            theme = localStorage.getItem("theme") || theme
          } catch {
            // keep the default
          }
          // "js": reveal blocks start hidden until GSAP fades them in
          html.className = theme + " js motion-safe:scroll-smooth"
          // Failsafe: if the animations never start (script blocked or
          // failed), show the hidden blocks instead of a blank page
          setTimeout(() => {
            if (!html.dataset.reveal) html.classList.remove("js")
          }, 4000)
        }
        // The browser bar matches the page, also when the toggle flips the class
        const syncThemeColor = () =>
          document.querySelector('meta[name="theme-color"]')?.setAttribute(
            "content",
            // sRGB of --background (oklch 0.145 / 0.975)
            html.classList.contains("dark") ? "#0a0a0a" : "#f7f7f7"
          )
        setTheme()
        syncThemeColor()
        // A reload starts at the top: the router would restore the saved
        // offset, which lands elsewhere once the animated page has settled.
        // Runs before the router reads the state; back/forward keep theirs
        if (performance.getEntriesByType("navigation")[0]?.type === "reload") {
          history.scrollRestoration = "manual"
          if (history.state) {
            history.replaceState(
              { ...history.state, scrollX: 0, scrollY: 0 },
              ""
            )
          }
        }
        new MutationObserver(syncThemeColor).observe(html, {
          attributes: true,
          attributeFilter: ["class"],
        })
        document.addEventListener("astro:after-swap", () => {
          setTheme()
          syncThemeColor()
        })
      })()
    </script>

    <!-- Structured data -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "@id": `${siteOrigin}/#organization`,
        name: "Kaizencode",
        alternateName: brandVariants,
        url: siteOrigin,
        logo: `${siteOrigin}${basePath}favicon/favicon.svg`,
        image: ogImageUrl,
        description,
        email: "contact@kaizencode.es",
        areaServed: [
          { "@type": "Country", name: "España" },
          { "@type": "City", name: "Cuenca" },
          { "@type": "City", name: "Valencia" },
          { "@type": "City", name: "Málaga" },
        ],
        sameAs: [
          "https://www.instagram.com/kaizencode/",
          "https://www.google.com/maps?cid=18208347427046395086",
        ],
        founder: team.map(({ nameKey, linkedin }) => ({
          "@type": "Person",
          name: ui[lang][nameKey],
          sameAs: [linkedin],
        })),
      })}
    />
    {isHome && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "WebSite",
          "@id": `${siteOrigin}/#website`,
          name: siteName,
          alternateName: brandVariants,
          url: `${siteOrigin}/`,
          inLanguage: ["es", "en"],
          publisher: { "@id": `${siteOrigin}/#organization` },
        })}
      />
    )}
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:bg-background focus:px-4 focus:py-2 focus:text-foreground focus:ring-2 focus:ring-ring focus:outline-hidden"
    >
      {ui[lang]["a11y.skip"]}
    </a>
    <!-- The entrance fades this wrapper, not the React element -->
    <div
      transition:persist="stars"
      class="stars-in fixed inset-0 opacity-50 md:opacity-100"
      aria-hidden="true"
    >
      <GravityStarsBackground
        client:idle={{ timeout: 800 }}
        starsCount={60}
        starsOpacity={0.6}
        glowIntensity={12}
        movementSpeed={0.2}
        mouseGravity="attract"
        className="text-foreground/50 [--stars-glow:0] dark:text-foreground dark:[--stars-glow:1]"
      />
    </div>
    <Header
      client:load
      transition:persist="header"
      lang={lang}
      path={Astro.url.pathname}
    />
    <slot />
    <script>
      import { initAnimations } from "@/lib/animations"

      let cleanup: (() => void) | undefined
      document.addEventListener("astro:page-load", () => {
        cleanup = initAnimations()
      })
      document.addEventListener("astro:before-swap", () => cleanup?.())
    </script>
  </body>
</html>
