---
import Layout from "@/layouts/main.astro"
import WebDesignContent from "@/components/custom/web-design-content.astro"
import { useTranslations } from "@/i18n/utils"

const lang = "en"
const city = "valencia"
const t = useTranslations(lang)
---

<Layout
  lang={lang}
  title={t(`city.${city}.title`)}
  description={t(`city.${city}.description`)}
>
  <WebDesignContent lang={lang} city={city} />
</Layout>
