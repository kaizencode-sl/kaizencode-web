---
import Layout from "@/layouts/main.astro"
import { getLangFromUrl, localizePath, useTranslations } from "@/i18n/utils"
import { buttonVariants } from "@/components/ui/button"
import { ArrowLeft } from "lucide-react"

// Determine the language from the URL path
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<Layout
  lang={lang}
  title={t("notfound.title")}
  description={t("notfound.description")}
>
  <div class="relative mx-auto flex min-h-[calc(100svh-4.5rem)] max-w-6xl flex-col px-6">
    <main
      id="main-content"
      class="flex flex-1 flex-col items-start justify-center gap-6 py-16"
    >
      <h1
        class="hero-in text-[min(3rem,12vw)] leading-tight font-bold tracking-tighter text-balance sm:text-[min(4.5rem,11vw)]"
        style="--i: 0"
      >
        {t("notfound.heading")}
      </h1>
      <p
        class="hero-in max-w-2xl text-base text-muted-foreground sm:text-lg"
        style="--i: 1"
      >
        {t("notfound.description")}
      </p>
      <div class="hero-in mt-2" style="--i: 2">
        <a
          href={localizePath(lang)}
          class={buttonVariants({
            size: "lg",
            className: "h-auto min-h-11 px-6 py-2 whitespace-normal shrink",
          })}
        >
          <ArrowLeft className="size-4" />
          {t("notfound.home")}
        </a>
      </div>
    </main>
  </div>
</Layout>
