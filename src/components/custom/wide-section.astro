---
// An edge-to-edge section of an inner page under a display-size title
export interface Props {
  title: string
  id?: string
}

const { title, id } = Astro.props
---

<section id={id} class="ml-[calc(50%-50vw)] w-screen px-6 sm:px-10 lg:px-16">
  <h2
    data-title-chars
    class="text-[min(11vw,6rem)] leading-[1.05] font-bold tracking-tighter text-balance"
  >
    {title}
  </h2>
  <div class="mt-8 lg:mt-16">
    <slot />
  </div>
</section>
