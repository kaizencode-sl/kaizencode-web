---
import { buttonVariants } from "@/components/ui/button"
import ContactSection from "@/components/custom/contact-section.astro"
import PageHero from "@/components/custom/page-hero.astro"
import WideSection from "@/components/custom/wide-section.astro"
import FeatureRows from "@/components/custom/feature-rows.astro"
import ProjectIndex from "@/components/custom/project-index.astro"
import ProcessSteps from "@/components/custom/process-steps.astro"
import FaqSection from "@/components/custom/faq-section.astro"
import { BackToTop } from "@/components/custom/back-to-top"
import SiteFooter from "@/components/custom/site-footer.astro"
import { ExternalLink, MapPin, ArrowRight } from "lucide-react"
import { localizePath, useTranslations } from "@/i18n/utils"
import { type Lang } from "@/i18n/ui"
import { cities, cityPath, team, type City } from "@/lib/team"
import { caseStudyPath } from "@/lib/case-studies"

export interface Props {
  lang: Lang
  city?: City
}

const { lang, city } = Astro.props
const t = useTranslations(lang)
const homeHref = localizePath(lang)
const cityName = city && t(`city.${city}`)
const member = city && team.find((m) => m.city === city)
const badge = cityName
  ? `${t("city.badge")} · ${cityName}`
  : t("webdesign.badge")
const heading = city ? t(`city.${city}.heading`) : t("webdesign.heading")
const intro = city ? t(`city.${city}.intro`) : t("webdesign.intro")

const otherLocations = cities
  .filter((c) => c !== city)
  .map((c) => ({ label: t(`city.${c}`), href: cityPath(c) }))

const includes: {
  title: string
  text: string
  href?: string
  link?: string
}[] = city
  ? [
      {
        title: t("service.custom.title"),
        text: t("service.custom.description"),
        href: localizePath(lang, "/automatizacion-ia/"),
        link: t("service.custom.link"),
      },
      {
        title: t("service.mobile.title"),
        text: t("service.mobile.description"),
        href: localizePath(lang, caseStudyPath("app-agora")),
        link: t("service.mobile.link"),
      },
      {
        title: t("service.web.title"),
        text: t("service.web.description"),
        href: localizePath(lang, "/diseno-web/"),
        link: t("service.web.link"),
      },
      {
        title: t("service.ecommerce.title"),
        text: t("service.ecommerce.description"),
        href: localizePath(lang, "/tiendas-online/"),
        link: t("service.ecommerce.link"),
      },
    ]
  : [
      {
        title: t("webdesign.includes.1.title"),
        text: t("webdesign.includes.1.text"),
      },
      {
        title: t("webdesign.includes.2.title"),
        text: t("webdesign.includes.2.text"),
      },
      {
        title: t("webdesign.includes.3.title"),
        text: t("webdesign.includes.3.text"),
      },
      {
        title: t("webdesign.includes.4.title"),
        text: t("webdesign.includes.4.text"),
      },
    ]

const steps = [
  t("webdesign.process.1"),
  t("webdesign.process.2"),
  t(city ? "city.process.3" : "webdesign.process.3"),
  t(city ? "city.process.4" : "webdesign.process.4"),
]

type Project = {
  slug: string
  name: string
  type: string
  text: string
  href?: string
  caseHref: string
  alt?: string
}
const webProjects: Project[] = [
  {
    slug: "agora",
    name: t("project.agora"),
    type: t("project.agora.type"),
    text: t("webdesign.projects.agora"),
    href: "https://www.agoraacademy.es/",
    caseHref: localizePath(lang, caseStudyPath("agora")),
  },
  {
    slug: "jovi",
    name: t("project.jovi"),
    type: t("project.jovi.type"),
    text: t("webdesign.projects.jovi"),
    href: "https://www.tabernajovi.es/",
    caseHref: localizePath(lang, caseStudyPath("jovi")),
  },
  {
    slug: "albinana",
    name: t("project.albinana"),
    type: t("project.albinana.type"),
    text: t("webdesign.projects.albinana"),
    href: "https://www.farmaciaalbinana.es/",
    caseHref: localizePath(lang, caseStudyPath("albinana")),
  },
]
const appAgora: Project = {
  slug: "app-agora",
  name: t("project.appAgora"),
  type: t("project.appAgora.type"),
  text: t("project.appAgora.description"),
  caseHref: localizePath(lang, caseStudyPath("app-agora")),
  alt: t("project.appAgora.image.alt"),
}
const centauro: Project = {
  slug: "centauro",
  name: t("project.centauro"),
  type: t("project.centauro.type"),
  text: t("project.centauro.description"),
  href: "https://shop.centauro.es/",
  caseHref: localizePath(lang, caseStudyPath("centauro")),
}
const [agora, jovi, albinana] = webProjects
// Local work first; Málaga has none yet, so lead with the B2B store and the app
const projects: Project[] = {
  none: webProjects,
  cuenca: [appAgora, agora, jovi],
  valencia: [albinana, centauro, appAgora],
  malaga: [centauro, appAgora, albinana],
}[city ?? "none"]

const faqs = city
  ? [
      { q: t("city.faq.1.q"), a: t("city.faq.1.a") },
      { q: t("city.faq.2.q"), a: t("city.faq.2.a") },
      { q: t("faq.remote.q"), a: t("faq.remote.a") },
    ]
  : [
      { q: t("webdesign.faq.1.q"), a: t("webdesign.faq.1.a") },
      { q: t("webdesign.faq.2.q"), a: t("webdesign.faq.2.a") },
      { q: t("webdesign.faq.3.q"), a: t("webdesign.faq.3.a") },
    ]
const cta = city
  ? ({
      title: "section.contact.title",
      text: "section.contact.text",
      button: "hero.cta.primary",
      subject: "contact.email.subject",
    } as const)
  : ({
      title: "webdesign.cta.title",
      text: "webdesign.cta.text",
      button: "webdesign.cta.button",
      subject: "webdesign.cta.subject",
    } as const)

const mailto = `mailto:contact@kaizencode.es?subject=${encodeURIComponent(t(cta.subject))}`

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
}
---

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(faqSchema)}
/>
<div class="relative mx-auto flex min-h-svh max-w-6xl flex-col px-6">
  <main
    id="main-content"
    class="flex flex-1 flex-col gap-16 py-10 md:gap-24 md:py-16 [&_section[id]]:scroll-mt-24"
  >
    <PageHero
      back={{ href: homeHref, label: t("webdesign.back") }}
      badge={badge}
      heading={heading}
      intro={intro}
    >
      {member && cityName && (
        <div class="flex items-center gap-4">
          <img
            src={member.avatar}
            alt=""
            width="56"
            height="56"
            class="size-14 shrink-0 rounded-full bg-muted object-cover"
          />
          <div class="flex min-w-0 flex-col gap-1">
            <span class="inline-flex items-center gap-1.5 font-semibold">
              <MapPin className="size-4" />
              {t("city.contact.title").replace("{city}", cityName)}
            </span>
            <span class="max-w-xl text-sm text-muted-foreground">
              {t("city.contact.text")
                .replace("{name}", t(member.nameKey))
                .replace("{city}", cityName)}
            </span>
            <a
              href={member.linkedin}
              target="_blank"
              rel="noopener"
              aria-label={`${t("about.linkedin.label")} ${t(member.nameKey)} ${t("a11y.newTab")}`}
              class="inline-flex min-h-6 items-center gap-1 text-xs text-muted-foreground underline-offset-4 hover:text-foreground hover:underline pointer-coarse:min-h-11"
            >
              {t("about.linkedin")}
              <ExternalLink className="size-3" />
            </a>
          </div>
        </div>
      )}
      <div class="flex flex-wrap gap-3">
        <a
          href={mailto}
          class={buttonVariants({
            size: "lg",
            className: "h-auto min-h-11 px-6 py-2 whitespace-normal shrink",
          })}
        >
          {t(cta.button)}
          <ArrowRight className="size-4" />
        </a>
        <a
          href="#projects"
          class={buttonVariants({
            variant: "outline",
            size: "lg",
            className:
              "h-auto min-h-11 border-foreground/20 px-6 py-2 whitespace-normal shrink",
          })}
        >
          {t("hero.cta.secondary")}
        </a>
      </div>
    </PageHero>

    <FeatureRows
      title={t(city ? "city.services.title" : "webdesign.includes.title")}
      items={includes}
    />

    <ProcessSteps
      lang={lang}
      title={t("webdesign.process.title")}
      steps={steps}
    />

    <section id="projects">
      <ProjectIndex
        lang={lang}
        title={t("webdesign.projects.title")}
        projects={projects.map(({ text, ...project }) => ({
          ...project,
          result: text,
        }))}
      />
    </section>

    <FaqSection title={t("webdesign.faq.title")} faqs={faqs} />

    {otherLocations.length > 0 && (
      <WideSection title={t("city.others.title")}>
        <ul class="border-b border-border">
          {otherLocations.map(({ label, href }) => (
            <li class="group relative flex items-center justify-between gap-6 border-t border-border py-5">
              <a
                href={href}
                class="text-2xl font-semibold tracking-tight transition-[translate] duration-500 ease-out after:absolute after:inset-0 group-hover:translate-x-2 lg:text-3xl"
              >
                {label}
              </a>
              <MapPin className="size-5 text-muted-foreground" />
            </li>
          ))}
        </ul>
      </WideSection>
    )}

    <ContactSection lang={lang} {...cta} />

    <SiteFooter lang={lang} />
  </main>
</div>
<BackToTop client:idle label={t("a11y.top")} />
