---
import { Badge } from "@/components/ui/badge"
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card"
import { buttonVariants } from "@/components/ui/button"
import ContactSection from "@/components/custom/contact-section.astro"
import { FaqAccordion } from "@/components/custom/faq-accordion"
import { Header } from "@/components/custom/header"
import { SectionHeader } from "@/components/custom/section-header"
import { BackToTop } from "@/components/custom/back-to-top"
import { DevelopedByKaizencode } from "@/components/ui/developed-by-kaizencode"
import {
  Palette,
  Search,
  Zap,
  Wrench,
  ExternalLink,
  MapPin,
  ArrowRight,
  ArrowLeft,
} from "lucide-react"
import { localizePath, useTranslations } from "@/i18n/utils"
import { type Lang } from "@/i18n/ui"
import { cities, cityPath, team, type City } from "@/lib/team"
import { caseStudyPath } from "@/lib/case-studies"

export interface Props {
  lang: Lang
  city?: City
}

const { lang, city } = Astro.props
const t = useTranslations(lang)
const homeHref = localizePath(lang)
const genericHref = localizePath(lang, "/diseno-web/")

const cityName = city && t(`city.${city}`)
const member = city && team.find((m) => m.city === city)
const badge = cityName
  ? `${t("webdesign.badge")} · ${cityName}`
  : t("webdesign.badge")
const heading = city ? t(`city.${city}.heading`) : t("webdesign.heading")
const intro = city ? t(`city.${city}.intro`) : t("webdesign.intro")

const otherLocations = [
  ...cities
    .filter((c) => c !== city)
    .map((c) => ({ label: t(`city.${c}`), href: cityPath(c) })),
  ...(city ? [{ label: t("city.others.spain"), href: genericHref }] : []),
]

const includes = [
  {
    title: t("webdesign.includes.1.title"),
    text: t("webdesign.includes.1.text"),
    icon: Palette,
  },
  {
    title: t("webdesign.includes.2.title"),
    text: t("webdesign.includes.2.text"),
    icon: Search,
  },
  {
    title: t("webdesign.includes.3.title"),
    text: t("webdesign.includes.3.text"),
    icon: Zap,
  },
  {
    title: t("webdesign.includes.4.title"),
    text: t("webdesign.includes.4.text"),
    icon: Wrench,
  },
]

const steps = [
  t("webdesign.process.1"),
  t("webdesign.process.2"),
  t("webdesign.process.3"),
  t("webdesign.process.4"),
]

const projects = [
  {
    slug: "agora",
    name: t("project.agora"),
    text: t("webdesign.projects.agora"),
    href: "https://www.agoraacademy.es/",
    caseHref: localizePath(lang, caseStudyPath("agora")),
  },
  {
    slug: "jovi",
    name: t("project.jovi"),
    text: t("webdesign.projects.jovi"),
    href: "https://www.tabernajovi.es/",
    caseHref: localizePath(lang, caseStudyPath("jovi")),
  },
  {
    slug: "albinana",
    name: t("project.albinana"),
    text: t("webdesign.projects.albinana"),
    href: "https://www.farmaciaalbinana.es/",
    caseHref: localizePath(lang, caseStudyPath("albinana")),
  },
]
// Show the local project first on the Valencia page
if (city === "valencia") projects.reverse()

const faqs = [
  { q: t("webdesign.faq.1.q"), a: t("webdesign.faq.1.a") },
  { q: t("webdesign.faq.2.q"), a: t("webdesign.faq.2.a") },
  { q: t("webdesign.faq.3.q"), a: t("webdesign.faq.3.a") },
]

const mailto = `mailto:contact@kaizencode.es?subject=${encodeURIComponent(t("webdesign.cta.subject"))}`

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
}
---

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(faqSchema)}
/>

<Header client:load lang={lang} path={Astro.url.pathname} />

<div class="relative mx-auto flex min-h-svh max-w-6xl flex-col px-6">
  <main
    id="main-content"
    class="flex flex-1 flex-col gap-24 py-16 [&_section[id]]:scroll-mt-24"
  >
    <section class="flex flex-col items-start">
      <a
        href={homeHref}
        class="hero-in mb-6 inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground pointer-coarse:mb-3 pointer-coarse:min-h-11"
        style="--i: 0"
      >
        <ArrowLeft className="size-3.5" />
        {t("webdesign.back")}
      </a>
      <div class="hero-in mb-6" style="--i: 1">
        <Badge
          variant="outline"
          className="h-auto max-w-full px-3 font-mono text-xs tracking-widest whitespace-normal"
        >
          {badge}
        </Badge>
      </div>
      <h1
        class="hero-in max-w-3xl text-[min(2.25rem,10vw)] leading-tight font-bold tracking-tighter text-balance sm:text-[min(3.75rem,9.5vw)]"
        style="--i: 2"
      >
        {heading}
      </h1>
      <p
        class="hero-in mt-6 max-w-2xl text-base text-muted-foreground sm:text-lg"
        style="--i: 3"
      >
        {intro}
      </p>
      {
        member && cityName && (
          <div class="hero-in mt-8" style="--i: 4">
            <Card size="sm">
              <CardContent className="flex items-center gap-4">
                <img
                  src={member.avatar}
                  alt=""
                  width="56"
                  height="56"
                  class="size-14 shrink-0 rounded-full bg-muted object-cover"
                />
                <div class="flex min-w-0 flex-col gap-1">
                  <span class="inline-flex items-center gap-1.5 font-semibold">
                    <MapPin className="size-4" />
                    {t("city.contact.title").replace("{city}", cityName)}
                  </span>
                  <span class="max-w-xl text-sm text-muted-foreground">
                    {t("city.contact.text")
                      .replace("{name}", t(member.nameKey))
                      .replace("{city}", cityName)}
                  </span>
                  <a
                    href={member.linkedin}
                    target="_blank"
                    rel="noopener"
                    aria-label={`${t("about.linkedin.label")} ${t(member.nameKey)} ${t("a11y.newTab")}`}
                    class="inline-flex min-h-6 items-center gap-1 text-xs text-muted-foreground underline-offset-4 hover:text-foreground hover:underline pointer-coarse:min-h-11"
                  >
                    {t("about.linkedin")}
                    <ExternalLink className="size-3" />
                  </a>
                </div>
              </CardContent>
            </Card>
          </div>
        )
      }
      <div class="hero-in mt-8 flex flex-wrap gap-3" style="--i: 5">
        <a
          href={mailto}
          class={buttonVariants({
            size: "lg",
            className: "h-auto min-h-11 px-6 py-2 whitespace-normal shrink",
          })}
        >
          {t("webdesign.cta.button")}
          <ArrowRight className="size-4" />
        </a>
        <a
          href="#projects"
          class={buttonVariants({
            variant: "outline",
            size: "lg",
            className:
              "h-auto min-h-11 border-foreground/20 px-6 py-2 whitespace-normal shrink",
          })}
        >
          {t("hero.cta.secondary")}
        </a>
      </div>
    </section>

    <section class="reveal flex flex-col gap-8">
      <SectionHeader title={t("webdesign.includes.title")} />
      <div class="grid gap-6 sm:grid-cols-2">
        {
          includes.map(({ title, text, icon: Icon }) => (
            <Card size="sm">
              <CardHeader>
                <CardTitle className="flex items-center gap-2.5">
                  <Icon className="size-5 shrink-0 text-muted-foreground transition-colors duration-300 group-hover/card:text-foreground" />
                  <h3>{title}</h3>
                </CardTitle>
                <CardDescription>{text}</CardDescription>
              </CardHeader>
            </Card>
          ))
        }
      </div>
    </section>

    <section class="reveal flex flex-col gap-8">
      <SectionHeader title={t("webdesign.process.title")} />
      <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((step, i) => (
            <li class="flex">
              <Card size="sm" className="w-full">
                <CardContent className="flex flex-col gap-2">
                  <span class="font-mono text-xs text-muted-foreground">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <span class="text-sm">{step}</span>
                </CardContent>
              </Card>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="projects" class="reveal flex flex-col gap-8">
      <SectionHeader title={t("webdesign.projects.title")} />
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          projects.map(({ slug, name, text, href, caseHref }) => (
            <li class="flex">
              <Card className="w-full pt-0">
                <img
                  src={`/projects/${slug}.webp`}
                  srcset={`/projects/${slug}-640.webp 640w, /projects/${slug}-960.webp 960w, /projects/${slug}.webp 1280w`}
                  sizes="(min-width: 1152px) 360px, (min-width: 640px) 50vw, 100vw"
                  alt={`${t("project.image.alt")} ${name}`}
                  width="1280"
                  height="800"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[16/10] w-full border-b border-border/50 bg-muted object-cover object-top"
                />
                <CardHeader>
                  <CardTitle>
                    <h3>{name}</h3>
                  </CardTitle>
                  <CardDescription>{text}</CardDescription>
                </CardHeader>
                <div class="mt-auto flex flex-wrap gap-x-5 gap-y-2 px-5 pointer-coarse:gap-y-0">
                  {caseHref && (
                    <a
                      href={caseHref}
                      class="inline-flex items-center gap-1.5 text-sm font-medium underline-offset-4 hover:underline pointer-coarse:min-h-11"
                    >
                      {t("project.case")}
                      <ArrowRight className="size-3.5" />
                    </a>
                  )}
                  <a
                    href={href}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-1.5 text-sm font-medium underline-offset-4 hover:underline pointer-coarse:min-h-11"
                  >
                    {t("project.visit")}
                    <ExternalLink className="size-3.5" />
                    <span class="sr-only">{t("a11y.newTab")}</span>
                  </a>
                </div>
              </Card>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="reveal flex flex-col gap-8">
      <SectionHeader title={t("webdesign.faq.title")} />
      <FaqAccordion client:visible faqs={faqs} />
    </section>

    <section class="reveal flex flex-col gap-8">
      <SectionHeader title={t("city.others.title")} />
      <ul class="flex flex-wrap gap-3">
        {
          otherLocations.map(({ label, href }) => (
            <li>
              <a
                href={href}
                class={buttonVariants({
                  variant: "outline",
                  size: "lg",
                  className:
                    "h-auto min-h-11 shrink border-foreground/20 px-5 py-2 whitespace-normal",
                })}
              >
                <MapPin className="size-3.5" />
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <ContactSection
      lang={lang}
      title="webdesign.cta.title"
      text="webdesign.cta.text"
      button="webdesign.cta.button"
      subject="webdesign.cta.subject"
    />

    <footer
      class="flex flex-col items-start justify-between gap-4 border-t border-border/50 px-4 py-6 text-xs text-muted-foreground sm:flex-row sm:items-center sm:gap-2"
    >
      <span class="text-sm"
        >&copy; {new Date().getFullYear()} {t("footer.copyright")}</span
      >
      <DevelopedByKaizencode lang={lang} />
    </footer>
  </main>
</div>
<BackToTop client:idle label={t("a11y.top")} />
