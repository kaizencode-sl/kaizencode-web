---
import { DevelopedByKaizencode } from "@/components/ui/developed-by-kaizencode"
import { useTranslations } from "@/i18n/utils"
import type { Lang } from "@/i18n/ui"

const { lang } = Astro.props as { lang: Lang }
const t = useTranslations(lang)
---

<footer class="flex flex-col items-start justify-between gap-4 border-t border-border/50 px-4 py-6 text-xs text-muted-foreground sm:flex-row sm:items-center sm:gap-2">
  <span class="text-sm">
    &copy; {new Date().getFullYear()} {t("footer.copyright")}
  </span>
  <DevelopedByKaizencode lang={lang} />
</footer>
