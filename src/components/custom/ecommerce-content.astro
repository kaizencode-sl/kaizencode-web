---
import { buttonVariants } from "@/components/ui/button"
import ContactSection from "@/components/custom/contact-section.astro"
import PageHero from "@/components/custom/page-hero.astro"
import WideSection from "@/components/custom/wide-section.astro"
import FeatureRows from "@/components/custom/feature-rows.astro"
import ProcessSteps from "@/components/custom/process-steps.astro"
import FaqSection from "@/components/custom/faq-section.astro"
import { BackToTop } from "@/components/custom/back-to-top"
import SiteFooter from "@/components/custom/site-footer.astro"
import { ArrowRight } from "lucide-react"
import { localizePath, useTranslations } from "@/i18n/utils"
import { type Lang } from "@/i18n/ui"
import { caseStudyPath } from "@/lib/case-studies"

export interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const caseHref = localizePath(lang, caseStudyPath("centauro"))

const includes = [
  {
    title: t("ecommerce.includes.1.title"),
    text: t("ecommerce.includes.1.text"),
  },
  {
    title: t("ecommerce.includes.2.title"),
    text: t("ecommerce.includes.2.text"),
  },
  {
    title: t("ecommerce.includes.3.title"),
    text: t("ecommerce.includes.3.text"),
  },
  {
    title: t("ecommerce.includes.4.title"),
    text: t("ecommerce.includes.4.text"),
  },
]

const caseFacts = [
  { label: t("case.facts.sector"), value: t("case.centauro.sector") },
  { label: t("case.facts.platform"), value: "SAP Commerce" },
  { label: t("case.facts.since"), value: t("case.centauro.since") },
]

const steps = [
  t("ecommerce.process.1"),
  t("ecommerce.process.2"),
  t("ecommerce.process.3"),
  t("ecommerce.process.4"),
]

const faqs = [
  { q: t("ecommerce.faq.1.q"), a: t("ecommerce.faq.1.a") },
  { q: t("ecommerce.faq.2.q"), a: t("ecommerce.faq.2.a") },
  { q: t("ecommerce.faq.3.q"), a: t("ecommerce.faq.3.a") },
  { q: t("ecommerce.faq.4.q"), a: t("ecommerce.faq.4.a") },
]

const mailto = `mailto:contact@kaizencode.es?subject=${encodeURIComponent(t("ecommerce.cta.subject"))}`

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
}
---

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(faqSchema)}
/>
<div class="relative mx-auto flex min-h-svh max-w-6xl flex-col px-6">
  <main
    id="main-content"
    class="flex flex-1 flex-col gap-16 py-10 md:gap-24 md:py-16 [&_section[id]]:scroll-mt-24"
  >
    <PageHero
      back={{ href: localizePath(lang), label: t("webdesign.back") }}
      badge={t("ecommerce.badge")}
      heading={t("ecommerce.heading")}
      intro={t("ecommerce.intro")}
    >
      <div class="flex flex-wrap gap-3">
        <a
          href={mailto}
          class={buttonVariants({
            size: "lg",
            className: "h-auto min-h-11 px-6 py-2 whitespace-normal shrink",
          })}
        >
          {t("case.cta.button")}
          <ArrowRight className="size-4" />
        </a>
        <a
          href="#case"
          class={buttonVariants({
            variant: "outline",
            size: "lg",
            className:
              "h-auto min-h-11 border-foreground/20 px-6 py-2 whitespace-normal shrink",
          })}
        >
          {t("ecommerce.case.title")}
        </a>
      </div>
    </PageHero>

    <FeatureRows title={t("ecommerce.includes.title")} items={includes} />

    <WideSection id="case" title={t("ecommerce.case.title")}>
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-8">
        <img
          src="/projects/centauro.webp"
          srcset="/projects/centauro-640.webp 640w, /projects/centauro-960.webp 960w, /projects/centauro.webp 1280w, /projects/centauro-1920.webp 1920w"
          sizes="(min-width: 1024px) 60vw, 100vw"
          alt={`${t("project.image.alt")} ${t("project.centauro")}`}
          width="1280"
          height="800"
          loading="lazy"
          decoding="async"
          class="aspect-[16/10] w-full bg-muted object-cover object-top grayscale transition-[filter] duration-500 hover:grayscale-0 lg:col-span-7"
        />
        <div class="flex flex-col items-start gap-6 lg:col-span-5">
          <p class="text-muted-foreground sm:text-lg">
            {t("ecommerce.case.intro")}
          </p>
          <dl class="w-full border-b border-border">
            {caseFacts.map(({ label, value }) => (
              <div class="flex items-baseline justify-between gap-6 border-t border-border py-3">
                <dt class="font-mono text-xs tracking-widest text-muted-foreground uppercase">
                  {label}
                </dt>
                <dd class="text-right text-sm font-medium">{value}</dd>
              </div>
            ))}
          </dl>
          <p class="text-muted-foreground sm:text-lg">
            {t("ecommerce.case.shopify")}
          </p>
          <a
            href={caseHref}
            class="inline-flex items-center gap-1.5 text-sm font-medium underline-offset-4 hover:underline pointer-coarse:min-h-11"
          >
            {t("automation.case.link")}
            <ArrowRight className="size-3.5" />
          </a>
        </div>
      </div>
    </WideSection>

    <ProcessSteps
      lang={lang}
      title={t("webdesign.process.title")}
      steps={steps}
    />

    <FaqSection title={t("webdesign.faq.title")} faqs={faqs} />

    <ContactSection
      lang={lang}
      title="ecommerce.cta.title"
      text="ecommerce.cta.text"
      button="case.cta.button"
      subject="ecommerce.cta.subject"
    />

    <SiteFooter lang={lang} />
  </main>
</div>
<BackToTop client:idle label={t("a11y.top")} />
