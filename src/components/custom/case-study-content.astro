---
import { Badge } from "@/components/ui/badge"
import {
  Card,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card"
import { Header } from "@/components/custom/header"
import { SectionHeader } from "@/components/custom/section-header"
import { BackToTop } from "@/components/custom/back-to-top"
import { DevelopedByKaizencode } from "@/components/ui/developed-by-kaizencode"
import { Check, ExternalLink, Mail } from "lucide-react"
import { localizePath, useTranslations } from "@/i18n/utils"
import { type Lang } from "@/i18n/ui"
import { caseStudies, type CaseStudySlug } from "@/lib/case-studies"

export interface Props {
  lang: Lang
  slug: CaseStudySlug
}

const { lang, slug } = Astro.props
const t = useTranslations(lang)
const study = caseStudies[slug]
const name = t(study.name)
const projectsHref = `${localizePath(lang)}#projects`

const facts = study.facts.map(({ label, value }) => ({
  label: t(label),
  value: typeof value === "string" ? t(value) : value.text,
}))
const challenge = study.challenge.map((key) => t(key))
const work = study.work.map(({ title, text, icon }) => ({
  title: t(title),
  text: t(text),
  icon,
}))
const stats = study.stats?.map(({ value, label }) => ({
  value,
  label: t(label),
}))
const value = study.value.map((key) => t(key))

const mailto = `mailto:contact@kaizencode.es?subject=${encodeURIComponent(t(study.cta.subject))}`
---

<Header client:load lang={lang} />

<div class="relative mx-auto flex min-h-svh max-w-6xl flex-col px-6">
  <main id="main-content" class="flex flex-1 flex-col gap-20 py-16">
    <section class="flex flex-col items-start">
      <a
        href={projectsHref}
        class="mb-6 text-sm text-muted-foreground transition-colors hover:text-foreground"
      >
        ← {t("case.back")}
      </a>
      <Badge
        variant="outline"
        className="mb-6 px-3 font-mono text-xs tracking-widest"
      >
        {t("case.badge")} · {name}
      </Badge>
      <h1
        class="max-w-3xl text-4xl leading-tight font-bold tracking-tighter sm:text-6xl"
      >
        {t(study.heading)}
      </h1>
      <p class="mt-6 max-w-2xl text-base text-muted-foreground sm:text-lg">
        {t(study.intro)}
      </p>
      <a
        href={study.site}
        target="_blank"
        rel="noopener"
        class="mt-8 inline-flex items-center gap-1.5 text-sm font-medium underline-offset-4 hover:underline"
      >
        {t(study.visit)}
        <ExternalLink className="size-3.5" />
      </a>
    </section>

    <section class="flex flex-col gap-6">
      <img
        src={`/projects/${slug}.webp`}
        srcset={`/projects/${slug}-640.webp 640w, /projects/${slug}-960.webp 960w, /projects/${slug}.webp 1280w`}
        sizes="(min-width: 1152px) 1104px, 100vw"
        alt={`${t("project.image.alt")} ${name}`}
        width="1280"
        height="800"
        class="aspect-[16/10] w-full rounded-2xl border border-border/50 bg-muted object-cover object-top"
      />
      <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {
          facts.map(({ label, value }) => (
            <div class="flex flex-col gap-1 rounded-xl border border-border/50 bg-secondary/30 p-4">
              <dt class="font-mono text-xs tracking-widest text-muted-foreground uppercase">
                {label}
              </dt>
              <dd class="text-sm font-medium">{value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="flex flex-col gap-8">
      <SectionHeader label="// 01" title={t("case.challenge.title")} />
      <div
        class="flex max-w-3xl flex-col gap-4 text-muted-foreground sm:text-lg"
      >
        {challenge.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <section class="flex flex-col gap-8">
      <SectionHeader label="// 02" title={t("case.work.title")} />
      <div class="grid gap-6 sm:grid-cols-3">
        {
          work.map(({ title, text, icon: Icon }) => (
            <Card size="sm" className="bg-secondary/30">
              <CardHeader>
                <div class="mb-1 flex size-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
                  <Icon className="size-5" />
                </div>
                <CardTitle>
                  <h3>{title}</h3>
                </CardTitle>
                <CardDescription>{text}</CardDescription>
              </CardHeader>
            </Card>
          ))
        }
      </div>
    </section>

    <section class="flex flex-col gap-8">
      <SectionHeader label="// 03" title={t(study.valueTitle)} />
      {
        stats && (
          <div class="flex flex-col gap-3">
            <dl class="grid gap-4 sm:grid-cols-3">
              {stats.map(({ value, label }) => (
                <div class="flex flex-col-reverse gap-1 rounded-xl border border-border/50 bg-secondary/30 p-6">
                  <dt class="text-sm text-muted-foreground">{label}</dt>
                  <dd class="font-mono text-4xl font-bold tracking-tighter">
                    {value}
                    <span class="text-lg text-muted-foreground">/100</span>
                  </dd>
                </div>
              ))}
            </dl>
            {study.statsNote && (
              <p class="text-xs text-muted-foreground">{t(study.statsNote)}</p>
            )}
          </div>
        )
      }
      <ul class="flex max-w-3xl flex-col gap-4">
        {
          value.map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
                <Check className="size-3.5" />
              </span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section
      class="flex flex-col items-start gap-4 rounded-2xl border border-border/50 bg-secondary/30 p-8"
    >
      <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
        {t(study.cta.title)}
      </h2>
      <p class="max-w-2xl text-muted-foreground">{t(study.cta.text)}</p>
      <a
        href={mailto}
        class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
      >
        <Mail className="size-4" />
        {t(study.cta.button)}
      </a>
    </section>

    <footer
      class="flex flex-col items-start justify-between gap-4 border-t border-border/50 px-4 py-6 text-xs text-muted-foreground sm:flex-row sm:items-center sm:gap-2"
    >
      <span class="text-sm"
        >&copy; {new Date().getFullYear()} {t("footer.copyright")}</span
      >
      <DevelopedByKaizencode lang={lang} />
    </footer>
  </main>
</div>
<BackToTop client:load />
