---
import { buttonVariants } from "@/components/ui/button"
import ContactSection from "@/components/custom/contact-section.astro"
import PageHero from "@/components/custom/page-hero.astro"
import WideSection from "@/components/custom/wide-section.astro"
import SplitSection from "@/components/custom/split-section.astro"
import FeatureRows from "@/components/custom/feature-rows.astro"
import { BackToTop } from "@/components/custom/back-to-top"
import { AppDemo } from "@/components/custom/app-demo"
import SiteFooter from "@/components/custom/site-footer.astro"
import {
  ArrowRight,
  Check,
  ExternalLink,
  MousePointerClick,
} from "lucide-react"
import { localizePath, useTranslations } from "@/i18n/utils"
import { type Lang } from "@/i18n/ui"
import { caseStudies, type CaseStudySlug } from "@/lib/case-studies"

export interface Props {
  lang: Lang
  slug: CaseStudySlug
}

const { lang, slug } = Astro.props
const t = useTranslations(lang)
const study = caseStudies[slug]
const name = t(study.name)
const projectsHref = `${localizePath(lang)}#projects`

const facts = study.facts.map(({ label, value }) => ({
  label: t(label),
  value: typeof value === "string" ? t(value) : value.text,
}))
const challenge = study.challenge.map((key) => t(key))
const work = study.work.map(({ title, text }) => ({
  title: t(title),
  text: t(text),
}))
const stats = study.stats?.map(({ value, label }) => ({
  value,
  label: t(label),
}))
const value = study.value.map((key) => t(key))
const imageAlt = study.imageAlt
  ? t(study.imageAlt)
  : `${t("project.image.alt")} ${name}`
const screens = study.screens
---

<div class="relative mx-auto flex min-h-svh max-w-6xl flex-col px-6">
  <main
    id="main-content"
    class="flex flex-1 flex-col gap-16 py-10 md:gap-24 md:py-16"
  >
    <PageHero
      back={{ href: projectsHref, label: t("case.back") }}
      badge={`${t("case.badge")} · ${name}`}
      heading={t(study.heading)}
      intro={t(study.intro)}
    >
      {study.site && study.visit && (
        <a
          href={study.site}
          target="_blank"
          rel="noopener"
          class={buttonVariants({
            variant: "outline",
            size: "lg",
            className:
              "h-auto min-h-11 shrink border-foreground/20 px-6 py-2 whitespace-normal",
          })}
        >
          {t(study.visit)}
          <ExternalLink className="size-3.5" />
          <span class="sr-only">{t("a11y.newTab")}</span>
        </a>
      )}
    </PageHero>

    <section class="flex flex-col gap-6">
      <img
        src={`/projects/${slug}.webp`}
        srcset={`/projects/${slug}-640.webp 640w, /projects/${slug}-960.webp 960w, /projects/${slug}.webp 1280w${slug === "app-agora" ? "" : `, /projects/${slug}-1920.webp 1920w`}`}
        sizes="100vw"
        alt={imageAlt}
        width="1280"
        height="800"
        fetchpriority="high"
        style="--i: 3"
        class="hero-in ml-[calc(50%-50vw)] aspect-[16/10] max-h-[calc(100svh-4rem)] w-screen max-w-none bg-muted object-cover object-top"
      />
      <dl class="ml-[calc(50%-50vw)] w-screen px-6 sm:px-10 lg:px-16 grid gap-x-8 sm:grid-cols-3 lg:grid-cols-5">
        {facts.map(({ label, value }) => (
          <div class="flex flex-col gap-1 border-t border-border py-4">
            <dt class="font-mono text-xs tracking-widest text-muted-foreground uppercase">
              {label}
            </dt>
            <dd class="text-sm font-medium">{value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <SplitSection title={t("case.challenge.title")}>
      <div class="flex flex-col gap-4 text-muted-foreground sm:text-lg">
        {challenge.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </SplitSection>

    <FeatureRows title={t("case.work.title")} items={work}>
      {study.services && (
        <div class="mt-8 flex flex-col items-start gap-2">
          {study.services.map(({ href, label }) => (
            <a
              href={localizePath(lang, href)}
              class="inline-flex items-center gap-1.5 text-sm font-medium underline-offset-4 hover:underline pointer-coarse:min-h-11"
            >
              {t(label)}
              <ArrowRight className="size-3.5" />
            </a>
          ))}
        </div>
      )}
    </FeatureRows>

    {study.demo && (
      <WideSection title={t("demo.title")}>
        <div class="grid items-center gap-10 lg:grid-cols-2">
          <div class="flex flex-col items-start gap-6">
            <p class="max-w-xl text-muted-foreground sm:text-lg">
              {t("demo.text")}
            </p>
            <ul class="w-full border-b border-border">
              {(["demo.hint.1", "demo.hint.2", "demo.hint.3"] as const).map(
                (key) => (
                  <li class="flex items-start gap-3 border-t border-border py-3">
                    <MousePointerClick className="mt-1 size-4 shrink-0 text-muted-foreground" />
                    <span>{t(key)}</span>
                  </li>
                )
              )}
            </ul>
            <p class="mt-2 font-semibold">{t("demo.cta.text")}</p>
            <a
              href="#contacto"
              class={buttonVariants({
                size: "lg",
                className: "h-auto min-h-11 shrink px-6 py-2 whitespace-normal",
              })}
            >
              {t("demo.cta.button")}
              <ArrowRight className="size-4" />
            </a>
          </div>
          <AppDemo client:visible lang={lang} />
        </div>
      </WideSection>
    )}

    {screens && (
      <WideSection title={t("case.screens.title")}>
        <ul class="-mx-6 flex snap-x snap-mandatory scroll-px-6 gap-4 overflow-x-auto px-6 pb-2 sm:mx-0 sm:grid sm:snap-none sm:grid-cols-2 sm:gap-6 sm:overflow-visible sm:px-0 lg:grid-cols-4">
          {screens.video && (
            <li class="w-[68%] shrink-0 snap-center sm:w-auto">
              <video
                src={screens.video.src}
                poster={screens.video.poster}
                aria-label={t(screens.video.label)}
                width="1206"
                height="2622"
                autoplay
                muted
                loop
                playsinline
                disablepictureinpicture
                preload="metadata"
                class="pointer-events-none aspect-[1206/2622] w-full rounded-[2rem] border border-border/50 bg-muted object-cover"
              />
            </li>
          )}
          {screens.images.map(({ src, alt }) => (
            <li class="w-[68%] shrink-0 snap-center sm:w-auto">
              <img
                src={src}
                alt={t(alt)}
                width="1206"
                height="2622"
                loading="lazy"
                decoding="async"
                class="aspect-[1206/2622] w-full rounded-[2rem] border border-border/50 bg-muted object-cover"
              />
            </li>
          ))}
        </ul>
        <p class="mt-4 text-xs text-muted-foreground">
          {t("case.screens.note")}
        </p>
      </WideSection>
    )}

    <SplitSection title={t(study.valueTitle)}>
      <div class="flex flex-col gap-10">
        {stats && (
          <div class="flex flex-col gap-3">
            <dl class="grid gap-x-8 sm:grid-cols-3">
              {stats.map(({ value, label }) => (
                <div class="flex flex-col-reverse gap-1 border-t border-border py-4">
                  <dt class="text-sm text-muted-foreground">{label}</dt>
                  <dd class="font-mono text-5xl font-bold tracking-tighter">
                    {value}
                    <span class="text-lg text-muted-foreground">/100</span>
                  </dd>
                </div>
              ))}
            </dl>
            {study.statsNote && (
              <p class="text-xs text-muted-foreground">{t(study.statsNote)}</p>
            )}
          </div>
        )}
        <ul class="border-b border-border">
          {value.map((item) => (
            <li class="flex items-start gap-3 border-t border-border py-4 sm:text-lg">
              <Check className="mt-1 size-4 shrink-0 text-muted-foreground" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </SplitSection>

    <ContactSection
      lang={lang}
      title={study.cta.title}
      text={study.cta.text}
      button={study.cta.button}
      subject={study.cta.subject}
    />

    <SiteFooter lang={lang} />
  </main>
</div>
<BackToTop client:idle label={t("a11y.top")} />
<script>
  // The gallery video has no controls: don't autoplay it for reduced motion
  document.addEventListener("astro:page-load", () => {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches)
      document
        .querySelectorAll("video[autoplay]")
        .forEach((v) => (v as HTMLVideoElement).pause())
  })
</script>
