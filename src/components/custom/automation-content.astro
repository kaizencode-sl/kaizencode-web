---
import { buttonVariants } from "@/components/ui/button"
import ContactSection from "@/components/custom/contact-section.astro"
import PageHero from "@/components/custom/page-hero.astro"
import WideSection from "@/components/custom/wide-section.astro"
import FeatureRows from "@/components/custom/feature-rows.astro"
import ProcessSteps from "@/components/custom/process-steps.astro"
import FaqSection from "@/components/custom/faq-section.astro"
import { BackToTop } from "@/components/custom/back-to-top"
import AutomationFlow from "@/components/custom/automation-flow.astro"
import SiteFooter from "@/components/custom/site-footer.astro"
import { ArrowRight } from "lucide-react"
import { localizePath, useTranslations } from "@/i18n/utils"
import { type Lang } from "@/i18n/ui"
import { caseStudyPath } from "@/lib/case-studies"

export interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const caseHref = localizePath(lang, caseStudyPath("albinana"))

const includes = [
  {
    title: t("automation.includes.1.title"),
    text: t("automation.includes.1.text"),
  },
  {
    title: t("automation.includes.2.title"),
    text: t("automation.includes.2.text"),
  },
  {
    title: t("automation.includes.3.title"),
    text: t("automation.includes.3.text"),
  },
  {
    title: t("automation.includes.4.title"),
    text: t("automation.includes.4.text"),
  },
]

const steps = [
  t("automation.process.1"),
  t("automation.process.2"),
  t("automation.process.3"),
  t("automation.process.4"),
]

const faqs = [
  { q: t("automation.faq.1.q"), a: t("automation.faq.1.a") },
  { q: t("automation.faq.2.q"), a: t("automation.faq.2.a") },
  { q: t("automation.faq.3.q"), a: t("automation.faq.3.a") },
]

const mailto = `mailto:contact@kaizencode.es?subject=${encodeURIComponent(t("automation.cta.subject"))}`

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
}
---

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(faqSchema)}
/>
<div class="relative mx-auto flex min-h-svh max-w-6xl flex-col px-6">
  <main
    id="main-content"
    class="flex flex-1 flex-col gap-16 py-10 md:gap-24 md:py-16 [&_section[id]]:scroll-mt-24"
  >
    <PageHero
      back={{ href: localizePath(lang), label: t("webdesign.back") }}
      badge={t("automation.badge")}
      heading={t("automation.heading")}
      intro={t("automation.intro")}
    >
      <div class="flex flex-wrap gap-3">
        <a
          href={mailto}
          class={buttonVariants({
            size: "lg",
            className: "h-auto min-h-11 px-6 py-2 whitespace-normal shrink",
          })}
        >
          {t("case.cta.button")}
          <ArrowRight className="size-4" />
        </a>
        <a
          href="#case"
          class={buttonVariants({
            variant: "outline",
            size: "lg",
            className:
              "h-auto min-h-11 border-foreground/20 px-6 py-2 whitespace-normal shrink",
          })}
        >
          {t("automation.case.title")}
        </a>
      </div>
    </PageHero>

    <FeatureRows title={t("automation.includes.title")} items={includes} />

    <WideSection id="case" title={t("automation.case.title")}>
      <div class="grid items-start gap-10 lg:grid-cols-12 lg:gap-8">
        <div class="flex flex-col items-start gap-6 lg:col-span-4">
          <p class="text-muted-foreground sm:text-lg">
            {t("automation.case.intro")}
          </p>
          <a
            href={caseHref}
            class="inline-flex items-center gap-1.5 text-sm font-medium underline-offset-4 hover:underline pointer-coarse:min-h-11"
          >
            {t("automation.case.link")}
            <ArrowRight className="size-3.5" />
          </a>
        </div>
        <div class="lg:col-span-8">
          <AutomationFlow lang={lang} />
        </div>
      </div>
    </WideSection>

    <ProcessSteps
      lang={lang}
      title={t("webdesign.process.title")}
      steps={steps}
    />

    <FaqSection title={t("webdesign.faq.title")} faqs={faqs} />

    <ContactSection
      lang={lang}
      title="automation.cta.title"
      text="automation.cta.text"
      button="case.cta.button"
      subject="automation.cta.subject"
    />

    <SiteFooter lang={lang} />
  </main>
</div>
<BackToTop client:idle label={t("a11y.top")} />
