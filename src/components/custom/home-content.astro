---
import { Badge } from "@/components/ui/badge"
import { Card, CardContent, CardHeader } from "@/components/ui/card"
import { buttonVariants } from "@/components/ui/button"
import ContactSection from "@/components/custom/contact-section.astro"
import ProcessSteps from "@/components/custom/process-steps.astro"
import ProjectIndex from "@/components/custom/project-index.astro"
import FaqSection from "@/components/custom/faq-section.astro"
import { SectionHeader } from "@/components/custom/section-header"
import { BackToTop } from "@/components/custom/back-to-top"
import { HeroTitle } from "@/components/custom/hero-title"
import SiteFooter from "@/components/custom/site-footer.astro"
import { ExternalLink, ArrowRight, Quote, MapPin } from "lucide-react"
import { localizePath, useTranslations } from "@/i18n/utils"
import { team, cityPath } from "@/lib/team"
import { caseStudyPath } from "@/lib/case-studies"
import { type Lang } from "@/i18n/ui"

export interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)

// Fill this in to show the testimonials block; empty stays hidden
const testimonials: {
  client: string
  name: string
  role: Record<Lang, string>
  quote: Record<Lang, string>
}[] = []

const stats = [
  {
    value: t("hero3.stat.experience"),
    label: t("hero3.stat.experience.label"),
  },
  { value: t("hero3.stat.projects"), label: t("hero3.stat.projects.label") },
  { value: t("hero3.stat.members"), label: t("hero3.stat.members.label") },
]

const projects = [
  {
    slug: "agora",
    name: t("project.agora"),
    type: t("project.agora.type"),
    result: t("project.agora.result"),
    tags: t("project.agora.tags").split(","),
    href: "https://www.agoraacademy.es/",
    caseHref: localizePath(lang, caseStudyPath("agora")),
  },
  {
    slug: "centauro",
    name: t("project.centauro"),
    type: t("project.centauro.type"),
    result: t("project.centauro.result"),
    tags: t("project.centauro.tags").split(","),
    href: "https://shop.centauro.es/",
    caseHref: localizePath(lang, caseStudyPath("centauro")),
  },
  {
    slug: "jovi",
    name: t("project.jovi"),
    type: t("project.jovi.type"),
    result: t("project.jovi.result"),
    tags: t("project.jovi.tags").split(","),
    href: "https://www.tabernajovi.es/",
    caseHref: localizePath(lang, caseStudyPath("jovi")),
  },
  {
    slug: "albinana",
    name: t("project.albinana"),
    type: t("project.albinana.type"),
    result: t("project.albinana.result"),
    tags: t("project.albinana.tags").split(","),
    href: "https://www.farmaciaalbinana.es/",
    caseHref: localizePath(lang, caseStudyPath("albinana")),
  },
  {
    slug: "app-agora",
    name: t("project.appAgora"),
    type: t("project.appAgora.type"),
    result: t("project.appAgora.result"),
    tags: t("project.appAgora.tags").split(","),
    alt: t("project.appAgora.image.alt"),
    caseHref: localizePath(lang, caseStudyPath("app-agora")),
  },
]

const services = [
  {
    title: t("service.ecommerce.title"),
    description: t("service.ecommerce.description"),
    badge: t("service.ecommerce.badge"),
    href: localizePath(lang, "/tiendas-online/"),
    link: t("service.ecommerce.link"),
    includes: [
      t("service.ecommerce.include.1"),
      t("service.ecommerce.include.2"),
      t("service.ecommerce.include.3"),
    ],
    photo: "/services/ecommerce.webp",
  },
  {
    title: t("service.custom.title"),
    description: t("service.custom.description"),
    badge: t("service.custom.badge"),
    href: localizePath(lang, "/automatizacion-ia/"),
    link: t("service.custom.link"),
    includes: [
      t("service.custom.include.1"),
      t("service.custom.include.2"),
      t("service.custom.include.3"),
    ],
    photo: "/services/custom.webp",
  },
  {
    title: t("service.web.title"),
    description: t("service.web.description"),
    badge: t("service.web.badge"),
    href: localizePath(lang, "/diseno-web/"),
    link: t("service.web.link"),
    includes: [
      t("service.web.include.1"),
      t("service.web.include.2"),
      t("service.web.include.3"),
    ],
    photo: "/services/web.webp",
  },
  {
    title: t("service.mobile.title"),
    description: t("service.mobile.description"),
    badge: t("service.mobile.badge"),
    href: localizePath(lang, caseStudyPath("app-agora")),
    link: t("service.mobile.link"),
    includes: [
      t("service.mobile.include.1"),
      t("service.mobile.include.2"),
      t("service.mobile.include.3"),
    ],
    photo: "/services/mobile.webp",
  },
]

const steps = [
  t("webdesign.process.1"),
  t("webdesign.process.2"),
  t("webdesign.process.3"),
  t("webdesign.process.4"),
]

const members = team.map(({ nameKey, roleKey, city, linkedin, avatar }) => ({
  name: t(nameKey),
  role: t(roleKey),
  linkedin,
  src: avatar,
  city: t(`city.${city}`),
  cityHref: cityPath(city),
}))

const faqs = [
  { q: t("faq.price.q"), a: t("faq.price.a") },
  { q: t("faq.code.q"), a: t("faq.code.a") },
  { q: t("faq.maintenance.q"), a: t("faq.maintenance.a") },
  { q: t("faq.remote.q"), a: t("faq.remote.a") },
]

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
}
---

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(faqSchema)}
/>
<div class="relative mx-auto flex min-h-svh max-w-6xl flex-col px-6">
  <main
    id="main-content"
    class="flex flex-1 flex-col justify-center gap-16 py-10 md:gap-24 md:py-16 [&_section[id]]:scroll-mt-24"
  >
    <section class="flex min-h-[calc(100svh-8rem)] flex-col items-start justify-center">
      <div class="hero-in mb-6" style="--i: 0">
        <Badge
          variant="outline"
          className="h-auto max-w-full px-3 font-mono text-xs tracking-widest whitespace-normal"
        >
          {t("hero.badge")}
        </Badge>
      </div>
      <h1 class="w-full">
        <HeroTitle
          text="Kaizencode"
          translate="no"
          className="text-[min(15vw,12.5rem)] leading-none font-bold tracking-tighter"
        />
        <span
          class="hero-in mt-2 block max-w-2xl text-xl font-semibold tracking-tight text-foreground/90 sm:text-2xl"
          style="--i: 3"
        >
          {t("hero.heading")}
        </span>
      </h1>
      <p
        class="hero-in mt-4 max-w-2xl text-base text-muted-foreground sm:text-lg"
        style="--i: 4"
      >
        {t("hero.support")}
      </p>
      <div class="hero-in mt-8 flex flex-wrap gap-3" style="--i: 5">
        <a
          href="#contacto"
          class={buttonVariants({
            size: "lg",
            className: "h-auto min-h-11 px-6 py-2 whitespace-normal shrink",
          })}
        >
          {t("hero.cta.primary")}
          <ArrowRight className="size-4" />
        </a>
        <a
          href="#projects"
          class={buttonVariants({
            variant: "outline",
            size: "lg",
            className:
              "h-auto min-h-11 border-foreground/20 px-6 py-2 whitespace-normal shrink",
          })}
        >
          {t("hero.cta.secondary")}
        </a>
      </div>
      <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3 font-mono text-sm text-muted-foreground">
        {stats.map(({ value, label }, i) => (
          <li class="hero-in" style={`--i: ${6 + i}`}>
            <span
              class="font-semibold text-foreground tabular-nums"
              data-count-up
            >
              {value}
            </span>{" "}
            {label}
          </li>
        ))}
      </ul>
    </section>

    <section class="ml-[calc(50%-50vw)] w-screen" data-scramble-track>
      <div class="flex items-center px-6 sm:px-10 md:min-h-[80svh] lg:px-16">
        <p class="text-[min(9vw,14svh,8rem)] leading-[1.1] font-bold tracking-tighter">
          <span class="sr-only">{t("statement.text")}</span>
          <span aria-hidden="true" data-scramble>
            {t("statement.text")}
          </span>
        </p>
      </div>
    </section>

    <section id="projects">
      <ProjectIndex
        lang={lang}
        title={t("section.projects.title")}
        projects={projects}
      />
    </section>

    <section id="services" class="flex flex-col gap-8">
      <div class="reveal">
        <SectionHeader title={t("section.services.title")} />
      </div>
      <!-- Edge-to-edge panels: each sticks under the header and the next slides
           over it. Sticky only with room for a whole panel. The scroll-linked
           motion lives in src/lib/animations.ts -->
      <ul class="ml-[calc(50%-50vw)] w-screen">
        {services.map(
          ({ title, description, badge, href, link, includes, photo }, i) => {
            const surface = [
              "bg-foreground text-background",
              "bg-secondary text-foreground",
              "bg-card text-foreground",
              "bg-background text-foreground",
            ][i]
            const muted =
              i === 0 ? "text-background/75" : "text-muted-foreground"
            return (
              <li
                data-stack-panel
                class="top-16 min-h-[calc(100svh-4rem)] motion-safe:[@media(min-height:700px)]:sticky motion-safe:[@media(min-height:700px)]:h-[calc(100svh-4rem)]"
              >
                <div
                  data-stack-inner
                  class={`relative flex h-full min-h-[calc(100svh-4rem)] origin-top flex-col justify-between gap-8 overflow-hidden p-6 sm:p-10 lg:px-16 ${surface}`}
                >
                  <div class="flex items-start justify-between gap-6">
                    <h3
                      data-stack-title
                      class="min-w-0 text-[min(13vw,15svh,11rem)] leading-[1.1] font-bold tracking-tighter text-balance lg:text-[min(10vw,16svh,10rem)]"
                    >
                      {title}
                    </h3>
                    <span
                      data-stack-number
                      aria-hidden="true"
                      class={`shrink-0 text-[clamp(3rem,8vw,7rem)] leading-none font-bold tracking-tighter tabular-nums ${muted}`}
                    >
                      {String(i + 1).padStart(2, "0")}
                    </span>
                  </div>
                  <div
                    data-stack-rest
                    class="grid flex-1 grid-rows-[auto_auto_minmax(10rem,1fr)] gap-6 border-t border-current/20 pt-6 md:grid-cols-2 lg:grid-cols-12 lg:grid-rows-[minmax(0,1fr)] lg:gap-8"
                  >
                    <div class="md:col-span-2 lg:col-span-2">
                      <Badge
                        variant="outline"
                        className="h-auto max-w-full border-current font-mono text-[11px] tracking-wider whitespace-normal text-current uppercase"
                      >
                        {badge}
                      </Badge>
                    </div>
                    <div class="flex flex-col items-start gap-4 lg:col-span-3">
                      <p class={`text-base ${muted}`}>{description}</p>
                      <a
                        href={href}
                        class="inline-flex min-h-11 items-center gap-2 border-b border-current text-base font-medium"
                      >
                        {link}
                        <ArrowRight className="size-4 shrink-0" />
                      </a>
                    </div>
                    <div class="hidden md:block lg:col-span-3">
                      <p class="font-mono text-sm font-medium">
                        {t("service.includes")}
                      </p>
                      <ul class={`mt-2 text-base ${muted}`}>
                        {includes.map((item) => (
                          <li class="border-b border-current/20 py-2">
                            {item}
                          </li>
                        ))}
                      </ul>
                    </div>
                    <div class="relative md:col-span-2 lg:col-span-4">
                      <img
                        src={photo}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        class="absolute inset-0 size-full object-cover"
                      />
                    </div>
                  </div>
                  <div
                    data-stack-shade
                    aria-hidden="true"
                    class="pointer-events-none absolute inset-0 bg-black opacity-0"
                  />
                </div>
              </li>
            )
          }
        )}
      </ul>
    </section>

    <div
      aria-hidden="true"
      data-marquee-track
      class="ml-[calc(50%-50vw)] w-screen overflow-clip"
    >
      <p
        data-marquee
        class="text-[min(16vw,22svh,14rem)] leading-tight font-bold tracking-tighter whitespace-nowrap text-foreground/40"
      >
        {[...services, ...services].map(({ title }) => `${title} · `).join("")}
      </p>
    </div>

    <ProcessSteps
      lang={lang}
      title={t("webdesign.process.title")}
      steps={steps}
    />

    {testimonials.length > 0 && (
      <section class="reveal flex flex-col gap-8">
        <SectionHeader title={t("section.testimonials.title")} />
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 sm:[&>:last-child:nth-child(odd)]:col-span-2 lg:[&>:last-child:nth-child(odd)]:col-span-1">
          {testimonials.map(({ client, name, role, quote }) => (
            <Card size="sm">
              <CardHeader>
                <Quote className="size-5 text-muted-foreground" />
                <blockquote class="text-base">{quote[lang]}</blockquote>
              </CardHeader>
              <CardContent className="mt-auto text-sm text-muted-foreground">
                <p class="font-medium text-foreground">{name}</p>
                <p>
                  {role[lang]} · {client}
                </p>
              </CardContent>
            </Card>
          ))}
        </div>
      </section>
    )}

    <section id="about" class="reveal flex flex-col gap-8">
      <SectionHeader title={t("about.title")} />
      <div class="flex flex-col gap-3">
        <p class="max-w-2xl text-xl font-semibold tracking-tight sm:text-2xl">
          {t("about.highlight")}
        </p>
        <p class="max-w-2xl text-base text-muted-foreground sm:text-lg">
          {t("about.description")}
        </p>
      </div>
      <ul class="ml-[calc(50%-50vw)] w-screen overflow-clip border-b border-border/50">
        {members.map(({ name, role, linkedin, src, city, cityHref }, i) => (
          <li class="relative grid grid-cols-[5rem_minmax(0,1fr)] items-center gap-x-4 gap-y-2 border-t border-border/50 px-6 py-6 sm:flex sm:items-center sm:gap-10 sm:px-10 sm:py-10 lg:px-16">
            <img
              src={src.replace("size=112", "size=480")}
              alt=""
              width="240"
              height="240"
              loading="lazy"
              class="size-20 shrink-0 rounded-full bg-muted object-cover sm:size-44 lg:size-60"
            />
            <div class="contents sm:flex sm:min-w-0 sm:flex-col sm:gap-3">
              <h3
                data-team-name={i % 2 ? "left" : "right"}
                class="text-[min(10vw,20svh,10rem)] leading-none font-bold tracking-tighter sm:text-[min(13vw,20svh,10rem)]"
              >
                {name}
              </h3>
              <p class="col-span-2 text-base text-muted-foreground sm:text-lg">
                {role}
              </p>
              <div class="col-span-2 flex flex-wrap gap-x-6">
                <a
                  href={cityHref}
                  class="inline-flex min-h-11 items-center gap-1.5 text-sm font-medium underline-offset-4 after:absolute after:inset-0 hover:underline sm:text-base"
                >
                  <MapPin className="size-4" />
                  {city}
                </a>
                <a
                  href={linkedin}
                  target="_blank"
                  rel="noopener"
                  aria-label={`${t("about.linkedin.label")} ${name} ${t("a11y.newTab")}`}
                  class="relative z-10 inline-flex min-h-11 items-center gap-1.5 text-sm font-medium underline-offset-4 hover:underline sm:text-base"
                >
                  {t("about.linkedin")}
                  <ExternalLink className="size-4" />
                </a>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <FaqSection title={t("webdesign.faq.title")} faqs={faqs} />

    <ContactSection
      lang={lang}
      title="section.contact.title"
      text="section.contact.text"
      button="hero.cta.primary"
      subject="contact.email.subject"
    />

    <SiteFooter lang={lang} />
  </main>
</div>
<BackToTop client:idle label={t("a11y.top")} />
