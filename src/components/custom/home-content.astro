---
import { Badge } from "@/components/ui/badge"
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card"
import { buttonVariants } from "@/components/ui/button"
import ContactSection from "@/components/custom/contact-section.astro"
import { FaqAccordion } from "@/components/custom/faq-accordion"
import { Header } from "@/components/custom/header"
import { SectionHeader } from "@/components/custom/section-header"
import { BackToTop } from "@/components/custom/back-to-top"
import { HeroTitle } from "@/components/custom/hero-title"
import { DevelopedByKaizencode } from "@/components/ui/developed-by-kaizencode"
import {
  ShoppingCart,
  Code,
  Smartphone,
  Palette,
  ExternalLink,
  ArrowRight,
  Quote,
  MapPin,
} from "lucide-react"
import { localizePath, useTranslations } from "@/i18n/utils"
import { team, cityPath } from "@/lib/team"
import { caseStudyPath } from "@/lib/case-studies"
import { type Lang } from "@/i18n/ui"

export interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)

// Fill this in to show the testimonials block; empty stays hidden
const testimonials: {
  client: string
  name: string
  role: Record<Lang, string>
  quote: Record<Lang, string>
}[] = []

const stats = [
  {
    value: t("hero3.stat.experience"),
    label: t("hero3.stat.experience.label"),
  },
  { value: t("hero3.stat.projects"), label: t("hero3.stat.projects.label") },
  { value: t("hero3.stat.members"), label: t("hero3.stat.members.label") },
]

const projects = [
  {
    slug: "centauro",
    name: t("project.centauro"),
    type: t("project.centauro.type"),
    description: t("project.centauro.description"),
    tags: t("project.centauro.tags").split(","),
    href: "https://shop.centauro.es/",
    caseHref: localizePath(lang, caseStudyPath("centauro")),
  },
  {
    slug: "jovi",
    name: t("project.jovi"),
    type: t("project.jovi.type"),
    description: t("project.jovi.description"),
    tags: t("project.jovi.tags").split(","),
    href: "https://www.tabernajovi.es/",
    caseHref: localizePath(lang, caseStudyPath("jovi")),
  },
  {
    slug: "albinana",
    name: t("project.albinana"),
    type: t("project.albinana.type"),
    description: t("project.albinana.description"),
    tags: t("project.albinana.tags").split(","),
    href: "https://www.farmaciaalbinana.es/",
    caseHref: localizePath(lang, caseStudyPath("albinana")),
  },
  {
    slug: "app-agora",
    name: t("project.appAgora"),
    type: t("project.appAgora.type"),
    description: t("project.appAgora.description"),
    tags: t("project.appAgora.tags").split(","),
    alt: t("project.appAgora.image.alt"),
    caseHref: localizePath(lang, caseStudyPath("app-agora")),
  },
  {
    slug: "agora",
    name: t("project.agora"),
    type: t("project.agora.type"),
    description: t("project.agora.description"),
    tags: t("project.agora.tags").split(","),
    href: "https://www.agoraacademy.es/",
    caseHref: localizePath(lang, caseStudyPath("agora")),
  },
]

const services = [
  {
    title: t("service.ecommerce.title"),
    description: t("service.ecommerce.description"),
    icon: ShoppingCart,
    badge: t("service.ecommerce.badge"),
    href: localizePath(lang, "/tiendas-online/"),
    link: t("service.ecommerce.link"),
  },
  {
    title: t("service.custom.title"),
    description: t("service.custom.description"),
    icon: Code,
    badge: t("service.custom.badge"),
    href: localizePath(lang, "/automatizacion-ia/"),
    link: t("service.custom.link"),
  },
  {
    title: t("service.web.title"),
    description: t("service.web.description"),
    icon: Palette,
    badge: t("service.web.badge"),
    href: localizePath(lang, "/diseno-web/"),
    link: t("service.web.link"),
  },
  {
    title: t("service.mobile.title"),
    description: t("service.mobile.description"),
    icon: Smartphone,
    badge: t("service.mobile.badge"),
    href: localizePath(lang, caseStudyPath("app-agora")),
    link: t("service.mobile.link"),
  },
]

const steps = [
  t("webdesign.process.1"),
  t("webdesign.process.2"),
  t("webdesign.process.3"),
  t("webdesign.process.4"),
]

const members = team.map(({ nameKey, roleKey, city, linkedin, avatar }) => ({
  name: t(nameKey),
  role: t(roleKey),
  linkedin,
  src: avatar,
  city: t(`city.${city}`),
  cityHref: cityPath(city),
}))

const faqs = [
  { q: t("faq.price.q"), a: t("faq.price.a") },
  { q: t("faq.code.q"), a: t("faq.code.a") },
  { q: t("faq.maintenance.q"), a: t("faq.maintenance.a") },
  { q: t("faq.remote.q"), a: t("faq.remote.a") },
]

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
}
---

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(faqSchema)}
/>

<Header client:load lang={lang} path={Astro.url.pathname} />

<div class="relative mx-auto flex min-h-svh max-w-6xl flex-col px-6">
  <main
    id="main-content"
    class="flex flex-1 flex-col justify-center gap-24 py-16 [&_section[id]]:scroll-mt-24"
  >
    <section class="flex flex-col items-start">
      <div class="hero-in mb-6" style="--i: 0">
        <Badge
          variant="outline"
          className="h-auto max-w-full px-3 font-mono text-xs tracking-widest whitespace-normal"
        >
          {t("hero.badge")}
        </Badge>
      </div>
      <h1>
        <HeroTitle
          text="Kaizencode"
          translate="no"
          className="text-[min(3rem,14vw)] leading-tight font-bold tracking-tighter sm:text-[min(4.5rem,12vw)]"
        />
        <span
          class="hero-in mt-2 block max-w-2xl text-xl font-semibold tracking-tight text-foreground/90 sm:text-2xl"
          style="--i: 3"
        >
          {t("hero.heading")}
        </span>
      </h1>
      <p
        class="hero-in mt-4 max-w-2xl text-base text-muted-foreground sm:text-lg"
        style="--i: 4"
      >
        {t("hero.support")}
      </p>
      <div class="hero-in mt-8 flex flex-wrap gap-3" style="--i: 5">
        <a
          href="#contacto"
          class={buttonVariants({
            size: "lg",
            className: "h-auto min-h-11 px-6 py-2 whitespace-normal shrink",
          })}
        >
          {t("hero.cta.primary")}
          <ArrowRight className="size-4" />
        </a>
        <a
          href="#projects"
          class={buttonVariants({
            variant: "outline",
            size: "lg",
            className:
              "h-auto min-h-11 border-foreground/20 px-6 py-2 whitespace-normal shrink",
          })}
        >
          {t("hero.cta.secondary")}
        </a>
      </div>
      <ul
        class="mt-10 flex flex-wrap gap-x-8 gap-y-3 font-mono text-sm text-muted-foreground"
      >
        {
          stats.map(({ value, label }, i) => (
            <li class="hero-in" style={`--i: ${6 + i}`}>
              <span
                class="font-semibold text-foreground tabular-nums"
                data-count-up
              >
                {value}
              </span>{" "}
              {label}
            </li>
          ))
        }
      </ul>
    </section>

    <section id="projects" class="reveal flex flex-col gap-8">
      <SectionHeader title={t("section.projects.title")} />
      <!-- Every project visible at once: case studies fill the top row -->
      <ul class="grid gap-6 md:grid-cols-2" data-stagger>
        {
          projects.map(
            ({ slug, name, type, description, tags, href, caseHref, alt }) => (
              <li class="flex">
                {/* With a case study, its link stretches over the whole card; the visit link sits above it */}
                <Card className="relative pt-0">
                  <img
                    src={`/projects/${slug}.webp`}
                    srcset={`/projects/${slug}-640.webp 640w, /projects/${slug}-960.webp 960w, /projects/${slug}.webp 1280w`}
                    sizes="(min-width: 1152px) 552px, (min-width: 768px) 50vw, 100vw"
                    alt={alt ?? `${t("project.image.alt")} ${name}`}
                    width="1280"
                    height="800"
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                    class="aspect-[16/10] w-full border-b border-border/50 bg-muted object-cover object-top"
                  />
                  <CardHeader>
                    <span class="font-mono text-xs tracking-widest text-muted-foreground uppercase">
                      {type}
                    </span>
                    <CardTitle>
                      <h3>{name}</h3>
                    </CardTitle>
                    <CardDescription>{description}</CardDescription>
                  </CardHeader>
                  <CardContent className="mt-auto flex flex-col items-start gap-4">
                    <div class="flex flex-wrap gap-2">
                      {tags.map((tag) => (
                        <Badge
                          variant="secondary"
                          className="font-mono text-[11px] tracking-wider uppercase"
                        >
                          {tag}
                        </Badge>
                      ))}
                    </div>
                    <div class="flex flex-wrap gap-x-5 gap-y-2 pointer-coarse:gap-y-0">
                      {caseHref && (
                        <a
                          href={caseHref}
                          class="inline-flex items-center gap-1.5 text-sm font-medium underline-offset-4 after:absolute after:inset-0 hover:underline pointer-coarse:min-h-11"
                        >
                          {t("project.case")}
                          <ArrowRight className="size-3.5" />
                        </a>
                      )}
                      {href && (
                        <a
                          href={href}
                          target="_blank"
                          rel="noopener"
                          class="relative z-10 inline-flex items-center gap-1.5 text-sm font-medium underline-offset-4 hover:underline pointer-coarse:min-h-11"
                        >
                          {t("project.visit")}
                          <ExternalLink className="size-3.5" />
                          <span class="sr-only">{t("a11y.newTab")}</span>
                        </a>
                      )}
                    </div>
                  </CardContent>
                </Card>
              </li>
            )
          )
        }
      </ul>
    </section>

    <section id="services" class="reveal flex flex-col gap-8">
      <SectionHeader title={t("section.services.title")} />
      <div class="grid gap-6 sm:grid-cols-2" data-stagger>
        {
          services.map(
            ({ title, description, icon: Icon, badge, href, link }) => (
              <div class="flex">
                <Card size="sm" className="relative w-full">
                  <CardHeader>
                    <CardTitle className="flex items-center gap-2.5">
                      <Icon className="size-5 shrink-0 text-muted-foreground transition-colors duration-300 group-hover/card:text-foreground" />
                      <h3>{title}</h3>
                    </CardTitle>
                    <CardDescription>{description}</CardDescription>
                  </CardHeader>
                  <CardContent className="mt-auto flex flex-col items-start gap-4">
                    <Badge
                      variant="secondary"
                      className="font-mono text-[11px] tracking-wider uppercase"
                    >
                      {badge}
                    </Badge>
                    {href && (
                      <a
                        href={href}
                        class="inline-flex items-center gap-1.5 text-sm font-medium underline-offset-4 after:absolute after:inset-0 hover:underline pointer-coarse:min-h-11"
                      >
                        {link}
                        <ArrowRight className="size-3.5" />
                      </a>
                    )}
                  </CardContent>
                </Card>
              </div>
            )
          )
        }
      </div>
    </section>

    <section class="reveal flex flex-col gap-8">
      <SectionHeader title={t("webdesign.process.title")} />
      <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
        {
          steps.map((step, i) => (
            <li class="flex">
              <Card size="sm" className="w-full">
                <CardContent className="flex flex-col gap-2">
                  <span class="font-mono text-xs text-muted-foreground">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <span class="text-sm">{step}</span>
                </CardContent>
              </Card>
            </li>
          ))
        }
      </ol>
    </section>

    {
      testimonials.length > 0 && (
        <section class="reveal flex flex-col gap-8">
          <SectionHeader title={t("section.testimonials.title")} />
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 sm:[&>:last-child:nth-child(odd)]:col-span-2 lg:[&>:last-child:nth-child(odd)]:col-span-1">
            {testimonials.map(({ client, name, role, quote }) => (
              <Card size="sm">
                <CardHeader>
                  <Quote className="size-5 text-muted-foreground" />
                  <blockquote class="text-base">{quote[lang]}</blockquote>
                </CardHeader>
                <CardContent className="mt-auto text-sm text-muted-foreground">
                  <p class="font-medium text-foreground">{name}</p>
                  <p>
                    {role[lang]} · {client}
                  </p>
                </CardContent>
              </Card>
            ))}
          </div>
        </section>
      )
    }

    <section id="about" class="reveal flex flex-col gap-8">
      <SectionHeader title={t("about.title")} />
      <div class="flex flex-col gap-3">
        <p class="max-w-2xl text-xl font-semibold tracking-tight sm:text-2xl">
          {t("about.highlight")}
        </p>
        <p class="max-w-2xl text-base text-muted-foreground sm:text-lg">
          {t("about.description")}
        </p>
      </div>
      <div class="grid gap-6 sm:grid-cols-3" data-stagger>
        {
          members.map(({ name, role, linkedin, src, city, cityHref }) => (
            // The city link stretches over the whole card; LinkedIn sits above it
            <div class="flex">
              <Card size="sm" className="relative w-full">
                <CardHeader className="flex items-center gap-4 sm:flex-col sm:items-start lg:flex-row lg:items-center">
                  <img
                    src={src}
                    alt=""
                    width="56"
                    height="56"
                    loading="lazy"
                    class="size-14 rounded-full bg-muted object-cover"
                  />
                  <div class="flex min-w-0 flex-col gap-1">
                    <CardTitle>
                      <h3>{name}</h3>
                    </CardTitle>
                    <CardDescription>{role}</CardDescription>
                    <div class="flex flex-wrap gap-x-4">
                      <a
                        href={cityHref}
                        class="inline-flex min-h-6 items-center gap-1 text-xs text-muted-foreground underline-offset-4 after:absolute after:inset-0 hover:text-foreground hover:underline pointer-coarse:min-h-11"
                      >
                        <MapPin className="size-3" />
                        {city}
                      </a>
                      <a
                        href={linkedin}
                        target="_blank"
                        rel="noopener"
                        aria-label={`${t("about.linkedin.label")} ${name} ${t("a11y.newTab")}`}
                        class="relative z-10 inline-flex min-h-6 items-center gap-1 text-xs text-muted-foreground underline-offset-4 hover:text-foreground hover:underline pointer-coarse:min-h-11"
                      >
                        {t("about.linkedin")}
                        <ExternalLink className="size-3" />
                      </a>
                    </div>
                  </div>
                </CardHeader>
              </Card>
            </div>
          ))
        }
      </div>
    </section>

    <section class="reveal flex flex-col gap-8">
      <SectionHeader title={t("webdesign.faq.title")} />
      <FaqAccordion client:visible faqs={faqs} />
    </section>

    <ContactSection
      lang={lang}
      title="section.contact.title"
      text="section.contact.text"
      button="hero.cta.primary"
      subject="contact.email.subject"
    />

    <footer
      class="flex flex-col items-start justify-between gap-4 border-t border-border/50 px-4 py-6 text-xs text-muted-foreground sm:flex-row sm:items-center sm:gap-2"
    >
      <span class="text-sm"
        >&copy; {new Date().getFullYear()} {t("footer.copyright")}</span
      >
      <DevelopedByKaizencode lang={lang} />
    </footer>
  </main>
</div>
<BackToTop client:idle label={t("a11y.top")} />
