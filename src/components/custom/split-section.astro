---
// The title holds on the left while the content runs on the right
export interface Props {
  title: string
}

const { title } = Astro.props
---

<section class="ml-[calc(50%-50vw)] grid w-screen gap-10 px-6 sm:px-10 lg:grid-cols-12 lg:gap-8 lg:px-16">
  <h2
    data-title-chars
    class="top-24 self-start text-[min(11vw,6rem)] leading-[1.05] font-bold tracking-tighter lg:sticky lg:col-span-5 lg:text-[min(6vw,6rem)]"
  >
    {title}
  </h2>
  <div class="reveal lg:col-span-7">
    <slot />
  </div>
</section>
