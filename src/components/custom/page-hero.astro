---
import { ArrowLeft } from "lucide-react"

// The opening of every inner page: a way back, the title at display size and,
// under a hairline, the tag, the intro and whatever the page puts in the slot
export interface Props {
  back: { href: string; label: string }
  badge: string
  heading: string
  intro: string
}

const { back, badge, heading, intro } = Astro.props
---

<section class="ml-[calc(50%-50vw)] w-screen px-6 sm:px-10 lg:px-16">
  <a
    href={back.href}
    class="hero-in mb-6 inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground pointer-coarse:mb-3 pointer-coarse:min-h-11"
    style="--i: 0"
  >
    <ArrowLeft className="size-3.5" />
    {back.label}
  </a>
  <h1
    class="hero-in text-[min(10.5vw,6.5rem)] leading-[1.05] font-bold tracking-tighter text-balance"
    style="--i: 1"
  >
    {heading}
  </h1>
  <div
    class="hero-in mt-10 grid gap-6 border-t border-border pt-6 lg:mt-14 lg:grid-cols-12 lg:gap-8"
    style="--i: 2"
  >
    <p class="font-mono text-xs tracking-widest text-muted-foreground uppercase lg:col-span-3">
      {badge}
    </p>
    <p class="text-base text-muted-foreground sm:text-lg lg:col-span-5">
      {intro}
    </p>
    <div class="flex flex-col items-start gap-6 lg:col-span-4">
      <slot />
    </div>
  </div>
</section>
