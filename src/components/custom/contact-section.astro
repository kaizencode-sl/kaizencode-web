---
import { buttonVariants } from "@/components/ui/button"
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
} from "@/components/ui/card"
import { SectionHeader } from "@/components/custom/section-header"
import { Mail } from "lucide-react"
import { useTranslations } from "@/i18n/utils"
import { type Lang, type UiKey } from "@/i18n/ui"

// The closing contact panel shared by every page, composed from shadcn's Card
// and button; each page brings its own pitch and email subject
export interface Props {
  lang: Lang
  title: UiKey
  text: UiKey
  button: UiKey
  subject: UiKey
}

const { lang, title, text, button, subject } = Astro.props
const t = useTranslations(lang)
const email = "contact@kaizencode.es"
const mailto = `mailto:${email}?subject=${encodeURIComponent(t(subject))}`
---

<section id="contacto" class="reveal flex scroll-mt-24 flex-col gap-8">
  <SectionHeader title={t(title)} />
  <Card className="gap-6 py-6 hover:translate-y-0 hover:shadow-sm sm:py-10">
    <CardHeader className="px-6 sm:px-10">
      <CardDescription className="max-w-2xl text-base">
        {t(text)}
      </CardDescription>
    </CardHeader>
    <CardContent className="flex flex-col items-start gap-3 px-6 sm:px-10">
      <a
        href={mailto}
        class={buttonVariants({
          size: "lg",
          className: "h-auto min-h-11 px-6 py-2 whitespace-normal shrink",
        })}
      >
        <Mail className="size-4" />
        {t(button)}
      </a>
      <p class="text-sm text-muted-foreground">
        {t("contact.description")}{" "}
        <a
          href={mailto}
          class="font-medium break-all text-foreground underline-offset-4 hover:underline"
          >{email}</a
        >
      </p>
    </CardContent>
  </Card>
</section>
